<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor: reconnect as soon as the network changes or comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Voice/video calls (lurker#680). Camera + a matching FGS type are optional:
         audio-only calls work without them. -->

    <application
        android:name=".LurkerApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lurker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lurker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share-sheet target: shared files upload through the account's
                 provider and the URL lands in the chosen conversation's draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Browser sign-in (Lurker 2.3+ OAuth) comes back to the app on the
             application id as a custom scheme: chat.irc.lurker:/oauth?code=…
             Invisible; it forwards the redirect into MainActivity and finishes. -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>

        <!-- Grants the camera app a write URI for the in-composer "Take photo"
             capture; authority is per-flavor so both identities coexist. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Opt-in background liveness anchor (Prefs.backgroundConnect). Holds no
             socket of its own; keeps the process alive so the shared client's
             WebSocket stays connected for background notifications. -->
        <!-- specialUse, not dataSync: Android 15+ caps dataSync at 6 hours a day,
             after which the OS stopped this anchor and the connection died
             overnight. HexDroid (also on Play) uses specialUse for the same job.
             Play Console asks for this justification at upload. -->
        <service
            android:name=".LurkerConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's IRC chat connection open in the background when they turn on Stay connected, so highlights and direct messages arrive in real time. IRC has no push service; shows an ongoing notification with a Stop action." />
        </service>

        <!-- Holds an active voice/video call in the foreground so the OS keeps the
             mic/camera capture alive while the app is backgrounded (lurker#680). -->

        <!-- Handles Reply / Mark-read / Mute actions on highlight & DM
             notifications (also the wrist actions on a paired Wear OS watch). -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />
    </application>

</manifest>